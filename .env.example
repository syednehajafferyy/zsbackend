# Neon POOLED connection string (host contains "-pooler"). Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
# Neon DIRECT connection string (no "-pooler"). Used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Random secret, 32+ characters. Generate: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Vercel Blob read-write token (only needed for product image uploads)
BLOB_READ_WRITE_TOKEN="REPLACE_WITH_BLOB_TOKEN"
# Used only by `npm run db:seed` to create the first admin
ADMIN_NAME="Administrator"
ADMIN_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
ADMIN_PASSWORD="REPLACE_WITH_PASSWORD_12_CHARS_MIN"
